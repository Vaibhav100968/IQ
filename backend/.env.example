# Copy this file to .env and fill in values:
#   cp .env.example .env
#
# Get credentials from:
#   https://supabase.com/dashboard → your project → Settings → API
#
# SUPABASE_URL          → Project URL
# SUPABASE_SERVICE_KEY  → service_role key (server-only; never use in the iOS app)
#
# Both are optional for local smoke tests. If unset, /predict and /simulate
# still work with in-memory history; /log will not persist to the cloud.
# Full setup: docs/BACKEND_SETUP.md

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here
